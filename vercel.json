{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/evenement",
      "destination": "/actualites.html"
    },
    {
      "source": "/evenements",
      "destination": "/actualites.html"
    }
  ]
}
